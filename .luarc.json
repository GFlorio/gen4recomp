{
  "runtime": {
    "version": "LuaJIT",
    "special": {
      "love.filesystem.load": "loadfile"
    }
  },
  "diagnostics": {
    "libraryFiles": "Disable"
  },
  "workspace": {
    "checkThirdParty": false,
    "library": ["vendor/lua-cats-love2d/library"],
    "ignoreDir": [".cache", ".git", ".claude", ".agents", "log", "tmp", "vendor/lua-cats-love2d"]
  }
}
